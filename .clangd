CompileFlags:
  Add:
    - "-std=c++20"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Werror"
    - "-Wconversion"
    - "-Wshadow"
    - "-fno-math-errno"
    - "-Wno-sign-conversion"
  Compiler: clang++

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - unused-function
    - unused-member-function
    - unused-template
    - unused-parameter
